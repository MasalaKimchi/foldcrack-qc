      "slide_id",
      "run_id",
      "content_id"
    ],
    "rules": [
      "No value for any unit key may occur in more than one cohort role.",
      "Thresholds and post-processing are locked on calibration before test inference.",
      "Patch extraction never changes the slide-level split assignment."
